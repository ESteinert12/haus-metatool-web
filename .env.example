# Copy to .env and fill in. .env is gitignored — never commit real values.

# Required. The server refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Required. The Neon connection string, rotated after the 2026-09-08 exposure.
DATABASE_URL=

# Backblaze B2 — rotated at the same time.
B2_APP_KEY_ID=
B2_APP_KEY=

# Dropbox refresh-token auth.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Set to 1 only for local http development; leaves the session cookie non-secure.
HAUS_INSECURE_COOKIE=

# Optional. Extra colon-separated roots the /api/fs/* routes may read and write.
HAUS_FS_EXTRA_ROOTS=
