{
  "version": 2,
  "buildCommand": "cd 'HAUS Workspace.app/Contents/Resources/haus-workspace' && npm install",
  "builds": [
    {
      "src": "HAUS Workspace.app/Contents/Resources/haus-workspace/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "HAUS Workspace.app/Contents/Resources/haus-workspace/**",
        "zeroConfig": true
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "HAUS Workspace.app/Contents/Resources/haus-workspace/server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "SESSION_SECRET": "@session_secret"
  }
}
